<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="EUREKABANK_DB_SERVIDOR" value="127.0.0.1"/>
    <add key="EUREKABANK_DB_PUERTO" value="3306"/>
    <add key="EUREKABANK_DB_ESQUEMA" value="eurekabank"/>
    <add key="EUREKABANK_DB_USUARIO" value="eurekabank_app"/>
    <add key="EUREKABANK_DB_CLAVE" value="EurekaBank2026!"/>
    <add key="EUREKABANK_TOKEN_MINUTOS" value="30"/>
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" culture="neutral" publicKeyToken="b03f5f7f11d50a3a"/>
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" maxRequestLength="64" executionTimeout="60"/>
  </system.web>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="EnlaceLimitado" maxReceivedMessageSize="65536" maxBufferSize="65536" maxBufferPoolSize="524288"
                 openTimeout="00:01:00" closeTimeout="00:01:00" sendTimeout="00:01:00" receiveTimeout="00:01:00">
          <readerQuotas maxDepth="32" maxStringContentLength="8192" maxArrayLength="16384" maxBytesPerRead="4096" maxNameTableCharCount="16384"/>
        </binding>
      </basicHttpBinding>
    </bindings>
    <services>
      <service name="ec.edu.monster.controladores.WSEUREKABANK" behaviorConfiguration="ComportamientoServicio">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="EnlaceLimitado"
                  contract="ec.edu.monster.controladores.IWSEUREKABANK"/>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior name="ComportamientoServicio">
          <serviceMetadata httpGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="false" httpHelpPageEnabled="false"/>
          <serviceThrottling maxConcurrentCalls="64" maxConcurrentSessions="100" maxConcurrentInstances="100"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="false" multipleSiteBindingsEnabled="true"/>
  </system.serviceModel>
</configuration>
