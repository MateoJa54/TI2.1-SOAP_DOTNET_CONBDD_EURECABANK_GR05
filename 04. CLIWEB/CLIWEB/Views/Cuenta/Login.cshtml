@model ec.edu.monster.web.modelo.LoginVista
@{
    ViewBag.Title = "Acceso";
}
<section class="acceso">
    <div class="acceso-cabecera">
        <img class="acceso-marca" src="@Url.Content("~/Content/img/marca.svg")" alt="" width="56" height="56" />
        <h1>EURECABANK</h1>
        <p class="texto-suave">Acceso para empleados</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Aviso))
    {
        <div class="aviso" role="status">@Model.Aviso</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="error" role="alert">@Model.Error</div>
    }

    @using (Html.BeginForm("Login", "Cuenta", FormMethod.Post, new { @class = "formulario" }))
    {
        @Html.AntiForgeryToken()
        <div class="campo">
            <label for="usuario">Usuario</label>
            <input id="usuario" name="usuario" type="text" value="@Model.Usuario" autocomplete="username" autofocus />
        </div>
        <div class="campo">
            <label for="clave">Clave</label>
            <input id="clave" name="clave" type="password" autocomplete="current-password" />
        </div>
        <button type="submit" class="btn btn-primario btn-bloque">Ingresar</button>
    }

    <p class="acceso-pie">La sesión dura 30 minutos desde que ingresa.</p>
    <img class="acceso-recurso" src="@Url.Content("~/Content/img/Monster.png")" alt="" />
</section>
